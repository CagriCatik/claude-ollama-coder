# ==============================================================================
# Claude-Ollama-Coder — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Anthropic-Compatible Ollama Endpoint
# ------------------------------------------------------------------------------
# Point Claude Code CLI to your Ollama daemon.
# For local Ollama:
ANTHROPIC_BASE_URL=http://localhost:11434
ANTHROPIC_AUTH_TOKEN=ollama
ANTHROPIC_API_KEY=""

# For Ollama Cloud (uncomment if using remote/cloud models):
# ANTHROPIC_BASE_URL=https://ollama.com
# ANTHROPIC_AUTH_TOKEN=your_ollama_api_key_here
# OLLAMA_API_KEY=your_ollama_api_key_here

# ------------------------------------------------------------------------------
# 2. Default Model Selection
# ------------------------------------------------------------------------------
# Default model used by launch-claude-ollama.sh, setup-ollama.sh, and run-claude.bat
# Cloud-backed (0 MB disk, 128k context):
CLAUDE_OLLAMA_MODEL=gpt-oss:20b-cloud

# Local offline alternatives (require disk space):
# CLAUDE_OLLAMA_MODEL=qwen3-coder
# CLAUDE_OLLAMA_MODEL=qwen2.5-coder:14b
# CLAUDE_OLLAMA_MODEL=deepseek-coder:6.7b

# ------------------------------------------------------------------------------
# 3. Context Window & Server Tuning
# ------------------------------------------------------------------------------
# Claude Code works best with at least 64k tokens of context.
OLLAMA_NUM_CTX=65536
OLLAMA_HOST=127.0.0.1:11434
